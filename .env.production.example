# ───────────────────────────────────────────────────────────────
# Vitoo — configuration production (copier vers .env.production)
# Copie :  cp .env.production.example .env.production  puis remplis.
# ───────────────────────────────────────────────────────────────

# URL publique de l'application (remplacer par ton domaine quand tu en auras un)
CLIENT_ORIGIN=http://TU-IP-PUBLIQUE

# ── CORS multi-domaines (séparés par des virgules) ────────────
# Chaque déploiement Vercel (site passager / site compagnie) a sa propre URL.
# Exemple :
# CLIENT_ORIGINS=https://vitoo.vercel.app,https://vitoo-company.vercel.app
CLIENT_ORIGINS=

PORT=4000

# Base SQLite — fichier dans le volume docker (ne PAS changer le path)
DATABASE_URL=file:/data/vitoo.db

# Clés API
ADMIN_API_KEY=change-me-admin-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── JWT ────────────────────────────────────────────────────────
# IMPORTANT : génère une longue chaîne aléatoire :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-strong-random-secret

# ── Compte admin initial (créé au premier démarrage si aucun admin n'existe) ──
ADMIN_BOOTSTRAP_PHONE=07XXXXXXXX
ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# ── SMS (laisser vide = mode démo console) ─────────────────────
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── E-mail Resend (laisser vide = mode démo console) ───────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=vitoo@resend.dev
RESEND_FROM_NAME=Vitoo
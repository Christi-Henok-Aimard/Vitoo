PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_API_KEY=change-this-admin-key
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

DATABASE_URL="file:./dev.db"

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret

# ── SMS ────────────────────────────────────────────────────────
# Africa's Talking (recommandé pour Côte d'Ivoire, Sénégal, Burkina, Mali…)
# Laisser vide pour passer sur Twilio, puis en mode démo (console).
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_FROM=

# Twilio (fallback international, optionnel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── E-mail (Resend) ───────────────────────────────────────────
# Laisser vide = mode démo (affiché en console)
RESEND_API_KEY=
RESEND_FROM_EMAIL=vitoo@resend.dev
RESEND_FROM_NAME=Vitoo

# ── CinetPay (paiement en ligne) ──────────────────────────────
# Compte marchand : https://cinetpay.com — clés du back-office.
# Laisser vide = mode simulation locale (test sans argent réel).
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# ──────────────────────────────────────────────────────────────
# PUBLIC_API_URL : URL publique de l'API backend (webhook CinetPay).
#   Ex. https://vitoo-api.onrender.com — requis en production dans le champ
#   notify_url du guichet. FRONTEND_URL : site passager pour le retour.
PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

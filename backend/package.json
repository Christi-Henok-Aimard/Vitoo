    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.26.0",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2"
  }
}
